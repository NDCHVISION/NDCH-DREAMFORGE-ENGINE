# Generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key
RUNWAY_API_KEY=your-runway-api-key
GITHUB_TOKEN=your-github-token
GITHUB_REPOSITORY=NDCHVISION/NDCH-DREAMFORGE-ENGINE
REEL_RELEASE_REPO=NDCHVISION/NDCH-DREAMFORGE-ENGINE
REEL_RELEASE_TAG=reel-latest
REEL_RELEASE_NAME=NDCH Dreamforge Latest Reel
REEL_RUNWAY_CONCURRENCY=2
ENGINE_CONFIG_PATH=./engine/viral-reel-engine.json
REEL_SPEC_PATH=./reels/reel_001_be_like_water.json
REEL_SCRIPT=
REEL_PROMPT=
REEL_MUSIC_PATH=

# Music Intelligence (analyze-reel-music.ts)
# Space-separated list of candidate MP3 paths, or pass --music flags to CLI
MUSIC_CANDIDATE_PATHS=
# Output directory for analysis artifacts (default: output/music_intelligence)
MUSIC_OUTPUT_DIR=output/music_intelligence
# Optional: preferred track filename hint for human-preference assessment
MUSIC_HUMAN_PREFERENCE=
# Sliding window stride in seconds (default 1.0; use 0.5 for finer search, costs 2x time)
MUSIC_STRIDE_SECONDS=1.0

# Publish
INSTAGRAM_PAGE_TOKEN=your-meta-page-token
IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
FB_PAGE_ID=your-facebook-page-id
REEL_VIDEO_URL=
REEL_CAPTION=
REEL_THUMB_OFFSET_MS=
REEL_SHARE_TO_FEED=true
